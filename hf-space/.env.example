# Copy to backend/.env for local development. In production set these as
# Space secrets/variables instead - never commit real values.

# --- Required ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=mednormalize

# --- CORS ---
# Exact frontend origin(s), comma separated, no trailing slash.
# Leaving this blank disables credentialed CORS and login will not work.
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-openssl-rand-hex-32
ADMIN_EMAIL=admin@mednormalize.ai
ADMIN_PASSWORD=change-me

# --- Cookies ---
# Production (frontend and API on different domains): true / none
# Local http development:                             false / lax
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- OCR ---
# Leave unset to auto-detect tesseract on PATH.
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=/usr/bin/tesseract
